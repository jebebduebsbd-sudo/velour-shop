# Velour environment configuration (example — never commit real values)
#
# Copy to `.env` for local development and fill in real values.
# All variables here are SERVER-side. Never expose them with NEXT_PUBLIC_.

# PostgreSQL connection string.
# Local development default: postgresql://velour:velour_dev@localhost:5432/velour
DATABASE_URL="postgresql://velour:velour_dev@localhost:5432/velour"

# Canonical origin of the deployment (used for origin validation and absolute URLs).
APP_ORIGIN="http://localhost:3000"

# Secret used to derive session and IP hashing keys (min 32 chars).
# REQUIRED in production; development falls back to a marked local value.
# Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Pepper mixed into email verification / password reset token hashes (min 16 chars).
# REQUIRED in production. Rotating this invalidates all outstanding email tokens.
# Generate with: openssl rand -base64 32
EMAIL_TOKEN_PEPPER=""

# 32-byte base64 master key used to encrypt inventory deliverables at rest.
# Generate with: openssl rand -base64 32
# Required for seeding and (in later phases) delivery. Keep outside the database.
DELIVERY_MASTER_KEY_B64=""

# HMAC secret used to verify payment provider webhooks (min 16 chars).
# Generate with: openssl rand -base64 24
PAYMENT_WEBHOOK_SECRET=""

# Payment providers are disabled by default. Set to "true" ONLY after the
# corresponding live adapter is implemented and merchant credentials are set.
# The mock provider covers local development regardless of these flags.
PAYMENT_DSK_ENABLED="false"
PAYMENT_NOWPAYMENTS_ENABLED="false"
PAYMENT_OVGC_ENABLED="false"

# NOWPayments (crypto) credentials — server-only. The provider is enabled only
# when PAYMENT_NOWPAYMENTS_ENABLED="true" AND both of these are set.
# Get them from your NOWPayments dashboard (API key + IPN/callback secret).
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""

# Supplier catalogue sync — disabled by default and fail-closed. It activates
# only when the flag is "true" AND both the feed URL and the API token are set.
# The token is a server secret: keep it here (or in your host's secret store),
# never in the repository, a prompt, or a chat message.
#
# Leave the URL/token lines commented out until you have a real feed —
# an empty value fails startup validation.
SUPPLIER_SYNC_ENABLED="false"
# SUPPLIER_FEED_URL="https://supplier.example.com/api/catalogue"
# SUPPLIER_API_TOKEN=""
# Optional: panels that use a custom header instead of "Authorization: Bearer".
# SUPPLIER_AUTH_HEADER="X-Api-Key"
# Optional: category slug used when a listing does not name a Velour category.
# SUPPLIER_FEED_DEFAULT_CATEGORY="steam"

# Optional local demo accounts (development only, never in production).
# No demo accounts are created unless you opt in here and choose a password.
SEED_DEMO_ACCOUNTS="false"
DEMO_ACCOUNT_PASSWORD=""
