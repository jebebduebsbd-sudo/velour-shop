# Velour environment configuration (example — never commit real values)
#
# Copy to `.env` for local development and fill in real values.
# All variables here are SERVER-side. Never expose them with NEXT_PUBLIC_.

# PostgreSQL connection string.
# Local development default: postgresql://velour:velour_dev@localhost:5432/velour
DATABASE_URL="postgresql://velour:velour_dev@localhost:5432/velour"

# Canonical origin of the deployment (used for origin validation and absolute URLs).
APP_ORIGIN="http://localhost:3000"

# Secret used to derive session and IP hashing keys (min 32 chars).
# REQUIRED in production; development falls back to a marked local value.
# Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Pepper mixed into email verification / password reset token hashes (min 16 chars).
# REQUIRED in production. Rotating this invalidates all outstanding email tokens.
# Generate with: openssl rand -base64 32
EMAIL_TOKEN_PEPPER=""

# 32-byte base64 master key used to encrypt inventory deliverables at rest.
# Generate with: openssl rand -base64 32
# Required for seeding and (in later phases) delivery. Keep outside the database.
DELIVERY_MASTER_KEY_B64=""

# HMAC secret used to verify payment provider webhooks (min 16 chars).
# Generate with: openssl rand -base64 24
PAYMENT_WEBHOOK_SECRET=""

# Payment providers are disabled by default. Set to "true" ONLY after the
# corresponding live adapter is implemented and merchant credentials are set.
# The mock provider covers local development regardless of these flags.
PAYMENT_DSK_ENABLED="false"
PAYMENT_NOWPAYMENTS_ENABLED="false"
PAYMENT_OVGC_ENABLED="false"

# NOWPayments (crypto) credentials — server-only. The provider is enabled only
# when PAYMENT_NOWPAYMENTS_ENABLED="true" AND both of these are set.
# Get them from your NOWPayments dashboard (API key + IPN/callback secret).
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""

# Discord order-completion alerts (optional). When ENABLED is "true" AND the
# webhook URL is set, a "New Sale" embed is posted to that channel after each
# fulfilled order. Disabled by default and fails closed — a missing URL simply
# sends nothing. The deliverable code is NEVER included in the alert.
# Create the webhook in your Discord channel: Edit Channel → Integrations →
# Webhooks → New Webhook → Copy Webhook URL, then paste it below.
DISCORD_ORDER_ALERTS_ENABLED="false"
DISCORD_ORDER_WEBHOOK_URL=""
# Optional hex color for the Discord embed (defaults to Velour indigo).
DISCORD_EMBED_COLOR=""

# Order-alert presentation (applies to all channels).
# Set to "false" to omit the customer email from alerts.
ORDER_ALERT_INCLUDE_EMAIL="true"
# Overrides the payment-method label shown in alerts.
ORDER_ALERT_PAYMENT_LABEL=""
# Fire a low-stock alert after a sale that leaves available units at or below
# this count. 0 disables low-stock alerts.
LOW_STOCK_ALERT_THRESHOLD="0"

# Telegram order alerts (optional). Enabled only when ENABLED is "true" AND
# both the bot token and chat id are set. Fails closed like the Discord channel.
# Create a bot via @BotFather; get the chat id from the target chat/channel.
TELEGRAM_ALERTS_ENABLED="false"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Authorized gift-code supplier sync. Disabled by default and fails closed:
# no live distributor adapter ships yet, so this imports nothing until one is
# onboarded with official API docs and server-side credentials. Never sources
# account credentials or non-transferable inventory.
SUPPLIER_SYNC_ENABLED="false"

# Optional local demo accounts (development only, never in production).
# No demo accounts are created unless you opt in here and choose a password.
SEED_DEMO_ACCOUNTS="false"
DEMO_ACCOUNT_PASSWORD=""
