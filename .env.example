# Salta7 store API — the supplier the catalog is listed from.
# Listing products uses the public /prices and /stock endpoints, so no token is needed.
SALTA7_API_BASE="https://salta7-store.ngrok.app"

# Only needed for authenticated calls (/buy, /balance, /task/*). Server-side only —
# never prefix this with NEXT_PUBLIC_, or it ships to the browser.
SALTA7_API_TOKEN=""
