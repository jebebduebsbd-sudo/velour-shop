generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  SUPPORT
  ADMIN
}

enum EmailTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  username         String          @unique
  /// Argon2id hash (or documented scrypt fallback). Never returned to clients.
  passwordHash     String
  role             Role            @default(CUSTOMER)
  emailVerifiedAt  DateTime?
  /// Set when the account is locked by an admin or by repeated failed logins.
  lockedUntil      DateTime?
  disabledAt       DateTime?
  failedLoginCount Int             @default(0)
  lastLoginAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  sessions         Session[]
  emailTokens      EmailToken[]
  auditEvents      AuditEvent[]
  ledgerAccounts   LedgerAccount[]
  walletTopUps     WalletTopUp[]

  @@index([role])
}

// ---------------------------------------------------------------------------
// Wallet ledger (append-only, double-entry).
//
// Balance is never stored as a mutable column. It is the signed sum of a
// user's postings, so history is auditable and can never silently drift.
// Amounts are integer minor units (e.g. euro cents); never floating point.
// ---------------------------------------------------------------------------

enum LedgerAccountKind {
  /// Real, cash-funded customer balance (spendable, refundable).
  USER_CASH
  /// Promotional / affiliate credit: spendable but non-withdrawable.
  USER_PROMO
  /// Funds reserved against an open order (moved out of USER_CASH).
  USER_HELD
  /// Platform-side counterparts that make each transaction balance to zero.
  HOUSE_FUNDING
  HOUSE_REVENUE
  HOUSE_PROMO
}

enum LedgerTxnType {
  TOP_UP
  HOLD
  HOLD_RELEASE
  PURCHASE
  REFUND
  CHARGEBACK
  ADMIN_ADJUSTMENT
  PROMO_CREDIT
}

model LedgerAccount {
  id        String            @id @default(cuid())
  kind      LedgerAccountKind
  currency  String            @default("EUR")
  /// Set for USER_* accounts; null for pooled HOUSE_* accounts.
  userId    String?
  user      User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())
  postings  LedgerPosting[]

  // One account per (user, kind, currency); house accounts are unique per kind.
  @@unique([userId, kind, currency])
  @@index([kind])
}

model LedgerTransaction {
  id            String          @id @default(cuid())
  type          LedgerTxnType
  currency      String          @default("EUR")
  /// Human-facing description; must never contain secrets or deliverables.
  description   String
  /// Deduplication key (e.g. provider event id). Enforces single-apply.
  idempotencyKey String?        @unique
  metadata      Json?
  createdAt     DateTime        @default(now())
  postings      LedgerPosting[]

  @@index([type, createdAt])
}

model LedgerPosting {
  id            String            @id @default(cuid())
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  accountId     String
  account       LedgerAccount     @relation(fields: [accountId], references: [id])
  /// Signed integer minor units. Sum across a transaction is always zero.
  amount        Int
  createdAt     DateTime          @default(now())

  @@index([accountId])
  @@index([transactionId])
}

enum TopUpStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

model WalletTopUp {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  /// Amount credited to the wallet on success (minor units).
  amountMinor       Int
  /// Provider fee shown to the user (minor units); informational.
  feeMinor          Int               @default(0)
  currency          String            @default("EUR")
  status            TopUpStatus       @default(PENDING)
  /// Provider-side reference (invoice/session id). Not a secret.
  providerReference String?           @unique
  /// Ledger transaction created when the verified webhook completes the top-up.
  ledgerTxnId       String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId, status])
}

/// Verified provider callbacks. The unique (provider, externalId) makes
/// webhook processing idempotent, so a replayed event credits the wallet once.
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  externalId  String
  /// Terse event type; raw payloads and signatures are never stored.
  eventType   String
  processedAt DateTime @default(now())

  @@unique([provider, externalId])
  @@index([provider, processedAt])
}

model Session {
  id             String    @id @default(cuid())
  /// SHA-256 of the opaque session token. The raw token exists only in the
  /// httpOnly cookie and is never stored or logged.
  tokenHash      String    @unique
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  revokedAt      DateTime?
  /// Timestamp of the last successful password confirmation, used to gate
  /// sensitive actions such as revealing a deliverable (step-up auth).
  reauthAt       DateTime?
  lastSeenAt     DateTime  @default(now())
  ipHash         String?
  userAgentBrief String?
  createdAt      DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model EmailToken {
  id        String            @id @default(cuid())
  /// Peppered SHA-256 of the token. Raw tokens are only ever emailed.
  tokenHash String            @unique
  purpose   EmailTokenPurpose
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, purpose])
}

/// Append-only audit trail. Rows are never updated or deleted, and must never
/// contain passwords, tokens, API keys, deliverable values, or card data.
model AuditEvent {
  id         String   @id @default(cuid())
  action     String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Type + id of the affected record, when applicable.
  targetType String?
  targetId   String?
  /// Non-sensitive structured context (reasons, counts, outcome codes).
  metadata   Json?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([userId, createdAt])
}

/// Fixed-window rate limit counters keyed by action + subject hash.
model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DeliveryType {
  INSTANT_CODE
  MANUAL
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  SOLD
  DISABLED
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  blurb     String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([sortOrder])
}

model Product {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  subtitle    String?
  /// Marketing description. Must not claim anything the deliverable does not include.
  description String
  /// Exact statement of what the buyer receives (shown verbatim on the product page).
  deliverable String
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id])
  /// Price in integer minor units (e.g. cents). Never floating point.
  priceMinor  Int
  currency    String          @default("USD")
  delivery    DeliveryType    @default(INSTANT_CODE)
  status      ProductStatus   @default(ACTIVE)
  /// Plain-language warranty statement for this product.
  warranty    String
  /// Region or platform restrictions shown to the buyer before purchase.
  region      String          @default("Global")
  featured    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  units       InventoryUnit[]

  @@index([categoryId, status])
  @@index([featured, status])
}

model InventoryUnit {
  id                 String          @id @default(cuid())
  productId          String
  product            Product         @relation(fields: [productId], references: [id])
  status             InventoryStatus @default(AVAILABLE)
  /// AES-256-GCM ciphertext of the authorized deliverable (code / key / voucher).
  /// Keys live outside the database (DELIVERY_MASTER_KEY_B64).
  payloadCiphertext  Bytes
  /// HMAC fingerprint of the plaintext payload, used for de-duplication only.
  payloadFingerprint String          @unique
  reservedAt         DateTime?
  soldAt             DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([productId, status])
}
