generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  SUPPORT
  ADMIN
}

enum EmailTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  username         String       @unique
  /// Argon2id hash (or documented scrypt fallback). Never returned to clients.
  passwordHash     String
  role             Role         @default(CUSTOMER)
  emailVerifiedAt  DateTime?
  /// Set when the account is locked by an admin or by repeated failed logins.
  lockedUntil      DateTime?
  disabledAt       DateTime?
  failedLoginCount Int          @default(0)
  lastLoginAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  sessions         Session[]
  emailTokens      EmailToken[]
  auditEvents      AuditEvent[]

  @@index([role])
}

model Session {
  id             String    @id @default(cuid())
  /// SHA-256 of the opaque session token. The raw token exists only in the
  /// httpOnly cookie and is never stored or logged.
  tokenHash      String    @unique
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  revokedAt      DateTime?
  /// Timestamp of the last successful password confirmation, used to gate
  /// sensitive actions such as revealing a deliverable (step-up auth).
  reauthAt       DateTime?
  lastSeenAt     DateTime  @default(now())
  ipHash         String?
  userAgentBrief String?
  createdAt      DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model EmailToken {
  id        String            @id @default(cuid())
  /// Peppered SHA-256 of the token. Raw tokens are only ever emailed.
  tokenHash String            @unique
  purpose   EmailTokenPurpose
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, purpose])
}

/// Append-only audit trail. Rows are never updated or deleted, and must never
/// contain passwords, tokens, API keys, deliverable values, or card data.
model AuditEvent {
  id         String   @id @default(cuid())
  action     String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Type + id of the affected record, when applicable.
  targetType String?
  targetId   String?
  /// Non-sensitive structured context (reasons, counts, outcome codes).
  metadata   Json?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([userId, createdAt])
}

/// Fixed-window rate limit counters keyed by action + subject hash.
model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DeliveryType {
  INSTANT_CODE
  MANUAL
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  SOLD
  DISABLED
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  blurb     String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([sortOrder])
}

model Product {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  subtitle    String?
  /// Marketing description. Must not claim anything the deliverable does not include.
  description String
  /// Exact statement of what the buyer receives (shown verbatim on the product page).
  deliverable String
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id])
  /// Price in integer minor units (e.g. cents). Never floating point.
  priceMinor  Int
  currency    String          @default("USD")
  delivery    DeliveryType    @default(INSTANT_CODE)
  status      ProductStatus   @default(ACTIVE)
  /// Plain-language warranty statement for this product.
  warranty    String
  /// Region or platform restrictions shown to the buyer before purchase.
  region      String          @default("Global")
  featured    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  units       InventoryUnit[]

  @@index([categoryId, status])
  @@index([featured, status])
}

model InventoryUnit {
  id                 String          @id @default(cuid())
  productId          String
  product            Product         @relation(fields: [productId], references: [id])
  status             InventoryStatus @default(AVAILABLE)
  /// AES-256-GCM ciphertext of the authorized deliverable (code / key / voucher).
  /// Keys live outside the database (DELIVERY_MASTER_KEY_B64).
  payloadCiphertext  Bytes
  /// HMAC fingerprint of the plaintext payload, used for de-duplication only.
  payloadFingerprint String          @unique
  reservedAt         DateTime?
  soldAt             DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([productId, status])
}
